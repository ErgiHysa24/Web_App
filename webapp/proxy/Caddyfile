# Proxy HTTPS davanti a WatchDog Web.
# Certificati firmati da una piccola autorità di certificazione locale, creata al primo avvio
# e conservata nel volume "caddy_data": niente Internet, niente Let's Encrypt.
# Nomi e indirizzi con cui si raggiunge l'applicazione: WATCHDOG_SERVER_NAMES nel file .env.
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	# I browser non mandano il nome (SNI) quando si apre l'applicazione con un indirizzo IP:
	# in quel caso si usa il certificato di questo indirizzo.
	default_sni {$WATCHDOG_DEFAULT_SNI:localhost}
	servers {
		protocols h1 h2
	}
}

{$WATCHDOG_SERVER_NAMES:localhost, 127.0.0.1} {
	tls internal
	request_body {
		max_size 512KB
	}
	header {
		-Server
		-Via
	}
	reverse_proxy {$WATCHDOG_UPSTREAM:web:8000} {
		header_down -Server
	}
}

# Chi apre l'indirizzo in HTTP viene mandato alla versione HTTPS.
http:// {
	redir https://{host}:{$WATCHDOG_HTTPS_PORT:8443}{uri} permanent
}
